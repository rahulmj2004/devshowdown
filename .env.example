# Copy to .env.local and fill in. Every variable is optional: with none set the
# site runs in a clearly labelled demo mode (nothing is saved, no real payment
# can be taken). Never commit .env.local. Placeholders only below.

# ------------------------------------------------------------------ site ----
# Public URL of the deployed site, used for canonical and social-share links.
NEXT_PUBLIC_SITE_URL=

# -------------------------------------------------------------- supabase ----
# Project Settings > API. Set both together.
# The anon key may be the legacy "anon" JWT or a newer "publishable" key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Lets the server store registrations and payments. Never prefix
# with NEXT_PUBLIC_ and never commit it. The "service_role" or "secret" key.
SUPABASE_SERVICE_ROLE_KEY=

# Used only when Supabase is NOT configured: not_open (default) | open | closed.
# With Supabase connected, organizers set this from the admin dashboard.
REGISTRATION_STATUS=

# -------------------------------------------------------------- razorpay ----
# Dashboard > Account & Settings > API Keys. Set both together.
# The key id is public (it is sent to the browser to open Checkout).
RAZORPAY_KEY_ID=
# SERVER ONLY. Signs orders and verifies payment signatures.
RAZORPAY_KEY_SECRET=
# SERVER ONLY. The secret you choose when creating the webhook
# (Dashboard > Account & Settings > Webhooks). Without it the webhook
# endpoint answers 503 and payments are confirmed by the checkout callback only.
RAZORPAY_WEBHOOK_SECRET=

# ----------------------------------------------------- development / test ----
# "mock" forces the simulated gateway even if Razorpay keys are set. Every
# screen labels it; registrations settled this way are flagged as test entries.
PAYMENT_MODE=
# Whole rupees charged per event by the MOCK gateway only, so the payment flow
# can be exercised before real fees are confirmed. Ignored for real payments.
DEV_FEE_OVERRIDE_INR=

# ----------------------------------------------------------------- email ----
# Optional confirmation email via Resend (https://resend.com). Set both
# together. EMAIL_FROM must be a sender verified in your Resend account.
RESEND_API_KEY=
EMAIL_FROM=
